{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.janus/hooks/block-file-edits.py\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.janus/hooks/block-bash-edits.py\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(janus list:*)",
      "Bash(janus show:*)",
      "Bash(janus search:*)",
      "Bash(janus notes)",
      "Bash(janus future-work)",
      "Bash(janus validate:*)"
    ]
  }
}
