# Caddy Reverse Proxy Configuration for Bulq - DEVELOPMENT
# Routes all traffic to backend and frontend services
# For production, use deployment/Caddyfile.prod

{
    # Disable automatic HTTPS in development
    auto_https off
}

:80 {
    # Enable gzip compression
    encode gzip

    # Security headers
    header {
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src 'self' wss: ws: http://localhost:*; img-src 'self' data:; font-src 'self'"
    }

    # Backend API - route /api/* to FastAPI
    reverse_proxy /api/* backend:8000 {
        header_up X-Forwarded-For {remote}
        header_up X-Forwarded-Proto {scheme}
    }

    # Frontend - proxy to Vite dev server
    reverse_proxy /* frontend:5173 {
        # Enable WebSocket support for Vite HMR
        header_up Upgrade {http.request.header.Upgrade}
        header_up Connection {http.request.header.Connection}
    }

    # Access logs for debugging
    log {
        output stdout
        format console
        level INFO
    }
}
